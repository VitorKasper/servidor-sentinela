<div class="auth-header">
  <div class="auth-icon">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
      stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
    </svg>
  </div>
  <h1 class="auth-title">Acesso ao Servidor</h1>
  <p class="auth-subtitle">Painel de Servidor & Gestão de Deploys na LAN</p>
</div>

<form action="/auth/login" method="POST">
  <div class="form-group">
    <label class="form-label" for="email">E-mail de Acesso</label>
    <input type="email" id="email" name="email" class="form-control" placeholder="admin@servidor.local" required
      autofocus>
  </div>

  <div class="form-group">
    <label class="form-label" for="password">Senha</label>
    <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
  </div>

  <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; margin-top: 12px;">
    Entrar no Sistema
  </button>
</form>