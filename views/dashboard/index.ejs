<div class="page-header">
  <div class="page-title-group">
    <h1>Visão Geral do Servidor</h1>
    <p>Monitoramento de recursos, status dos serviços e aplicações ativas na LAN.</p>
  </div>
  <% if (currentUser && currentUser.role === 'ADMIN') { %>
    <div>
      <a href="/projects/create" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Puxar Projeto do GitHub
      </a>
    </div>
  <% } %>
</div>

<!-- Métricas Principais -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon-box stat-cyan">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.total %></div>
      <div class="stat-label">Total de Projetos</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon-box stat-green">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.running %></div>
      <div class="stat-label">Em Execução (Online)</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon-box stat-amber">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="10" y1="15" x2="10" y2="9"></line><line x1="14" y1="15" x2="14" y2="9"></line></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= stats.stopped %></div>
      <div class="stat-label">Parados</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon-box stat-cyan">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= system.memoryUsed %> <span style="font-size: 1rem; color: var(--text-muted);">/ <%= system.memoryTotal %> GB</span></div>
      <div class="stat-label">Memória RAM (<%= system.memoryPercent %>%)</div>
    </div>
  </div>
</div>

<!-- Informações de Rede e Acesso LAN -->
<div class="card" style="margin-bottom: 32px;">
  <div class="card-header">
    <div class="card-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
      Acesso na Rede Local (LAN)
    </div>
    <a href="/ports" class="btn btn-secondary btn-sm">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
      Ver Portas Ocupadas & Livres
    </a>
  </div>
  <div class="card-body">
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px;">
      Qualquer computador ou dispositivo conectado na mesma rede pode acessar o painel e os serviços hospedados através dos seguintes endereços:
    </p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
      <% if (network.localIps && network.localIps.length > 0) { %>
        <% network.localIps.forEach(function(item) { %>
          <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); padding: 12px 18px; border-radius: var(--radius-md); font-family: var(--font-mono); font-size: 0.9rem; display: flex; align-items: center; gap: 10px;">
            <span style="color: var(--text-dim); font-size: 0.75rem; text-transform: uppercase;"><%= item.interface %>:</span>
            <strong style="color: var(--accent-cyan);">http://<%= item.address %>:<%= network.serverPort %></strong>
          </div>
        <% }); %>
      <% } else { %>
        <div style="background: var(--bg-surface-elevated); padding: 12px 18px; border-radius: var(--radius-md); font-family: var(--font-mono); font-size: 0.9rem;">
          <strong style="color: var(--accent-cyan);">http://localhost:<%= network.serverPort %></strong>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Projetos Recentes -->
<div class="card">
  <div class="card-header">
    <div class="card-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
      Aplicações Hospedadas
    </div>
    <a href="/projects" class="btn btn-secondary btn-sm">Ver Todos</a>
  </div>
  <div class="card-body" style="padding: 0;">
    <% if (projects.length === 0) { %>
      <div style="text-align: center; padding: 48px 24px; color: var(--text-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 12px; opacity: 0.5;"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        <p style="font-size: 1.1rem; font-weight: 600; color: var(--text-main);">Nenhum projeto cadastrado no momento</p>
        <p style="font-size: 0.85rem; margin-top: 4px;">Cadastre seu primeiro repositório do GitHub para iniciar o deploy automático.</p>
        <% if (currentUser && currentUser.role === 'ADMIN') { %>
          <a href="/projects/create" class="btn btn-primary" style="margin-top: 18px;">Puxar do GitHub</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Projeto</th>
              <th>Repositório</th>
              <th>Status</th>
              <th>PID</th>
              <th>Porta LAN</th>
              <th>Último Deploy</th>
              <th style="text-align: right;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% projects.slice(0, 5).forEach(function(proj) { %>
              <tr>
                <td>
                  <strong style="color: var(--text-main); font-size: 0.95rem;"><%= proj.name %></strong>
                  <div style="font-size: 0.75rem; color: var(--text-dim); font-family: var(--font-mono);">branch: <%= proj.branch %></div>
                </td>
                <td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);">
                  <%= proj.repoUrl %>
                </td>
                <td>
                  <span class="status-pill status-<%= proj.status %>" data-project-status-id="<%= proj.id %>">
                    <span class="status-dot"></span>
                    <span class="status-text"><%= proj.status %></span>
                  </span>
                </td>
                <td style="font-family: var(--font-mono); font-size: 0.85rem;" data-project-pid-id="<%= proj.id %>">
                  <%= proj.pid ? '#' + proj.pid : 'Inativo' %>
                </td>
                <td style="font-family: var(--font-mono); font-size: 0.85rem;">
                  <% if (proj.port) { %>
                    <a href="http://<%= network.primaryIp %>:<%= proj.port %>" target="_blank" style="color: var(--accent-cyan); text-decoration: underline;">
                      :<%= proj.port %>
                    </a>
                  <% } else { %>
                    <span style="color: var(--text-dim);">-</span>
                  <% } %>
                </td>
                <td style="font-size: 0.8rem; color: var(--text-muted);">
                  <%= proj.lastDeployedAt ? new Date(proj.lastDeployedAt).toLocaleString('pt-BR') : 'Nunca' %>
                </td>
                <td style="text-align: right;">
                  <a href="/projects/<%= proj.id %>/terminal" class="btn btn-secondary btn-sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                    Terminal
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
