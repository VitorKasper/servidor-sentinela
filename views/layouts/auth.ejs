<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : (typeof companyName !== 'undefined' ? 'Autenticação - ' + companyName : 'Autenticação - Servidor Sentinela') %></title>
  <% if (typeof companyLogoUrl !== 'undefined' && companyLogoUrl) { %>
    <link rel="icon" id="dynamicFavicon" href="<%= companyLogoUrl %>">
  <% } else { %>
    <link rel="icon" id="dynamicFavicon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%23080c14'/><path d='M50 12 L85 28 L85 68 L50 88 L15 68 L15 28 Z' fill='none' stroke='%2300f0ff' stroke-width='6'/><text x='50%' y='56%' dominant-baseline='middle' text-anchor='middle' fill='%2300f0ff' font-family='sans-serif' font-size='38' font-weight='800'><%= typeof companyName !== 'undefined' && companyName ? companyName.charAt(0).toUpperCase() : 'S' %></text></svg>">
  <% } %>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .auth-page-wrapper {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      position: relative;
    }
    .auth-card {
      width: 100%;
      max-width: 440px;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 40px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 240, 255, 0.05);
      position: relative;
      overflow: hidden;
    }
    .auth-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--accent-cyan), var(--accent-blue), var(--accent-purple));
    }
    .auth-header {
      text-align: center;
      margin-bottom: 32px;
    }
    .auth-icon {
      width: 56px;
      height: 56px;
      margin: 0 auto 16px;
      background: rgba(0, 240, 255, 0.1);
      border: 1px solid rgba(0, 240, 255, 0.3);
      border-radius: var(--radius-lg);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-cyan);
      box-shadow: 0 0 20px rgba(0, 240, 255, 0.2);
    }
    .auth-title {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .auth-subtitle {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 6px;
    }
  </style>
</head>
<body>
  <div class="auth-page-wrapper">
    <div class="auth-card">
      <%- include('../partials/alerts') %>
      <%- body %>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
