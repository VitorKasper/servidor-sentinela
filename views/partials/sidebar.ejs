<aside class="sidebar">
  <div class="brand-container">
    <div class="brand-logo-wrapper" id="sidebarLogoWrapper" <% if (currentUser && currentUser.role === 'ADMIN') { %>style="cursor: pointer;" title="Clique para enviar ou alterar a logo da empresa"<% } %>>
      <% if (typeof companyLogoUrl !== 'undefined' && companyLogoUrl) { %>
        <div class="brand-img-box" id="sidebarImgBox">
          <img src="<%= companyLogoUrl %>" id="sidebarLogoImg" class="brand-custom-logo-img" alt="Logo da Empresa">
          <% if (currentUser && currentUser.role === 'ADMIN') { %>
            <div class="brand-img-overlay">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="brand-dashed-slot" id="sidebarDashedSlot" title="Nenhuma logo enviada. Clique para fazer upload (+)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </div>
      <% } %>
    </div>
    <div class="brand-text-wrapper" <% if (currentUser && currentUser.role === 'ADMIN') { %>style="cursor: pointer;" title="Clique para editar o nome da empresa"<% } %>>
      <div class="brand-name" id="sidebarBrandName"><%= typeof companyName !== 'undefined' ? companyName : 'SENTINELA' %></div>
      <div class="brand-tag" id="sidebarBrandTag"><%= typeof companyTag !== 'undefined' ? companyTag : 'Server PaaS Hub' %></div>
    </div>
  </div>

  <div class="nav-section">
    <div class="nav-title">Navegação Principal</div>
    
    <a href="/dashboard" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/dashboard') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      Dashboard
    </a>

    <a href="/projects" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/projects') && currentPath !== '/projects/create') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
      Projetos & Deploys
    </a>

    <a href="/ports" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/ports') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      Monitor de Portas
    </a>

    <% if (currentUser && currentUser.role === 'ADMIN') { %>
      <div class="nav-title" style="margin-top: 16px;">Administração</div>
      
      <a href="/projects/create" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/projects/create') ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
        Puxar do GitHub
      </a>

      <a href="/users" class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/users')) ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        Gerenciar Operadores
      </a>
    <% } %>
  </div>

  <div class="sidebar-footer">
    <a href="/auth/logout" class="btn-logout">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      Encerrar Sessão
    </a>
  </div>
</aside>
