<div class="page-header">
  <div class="page-title-group">
    <h1>Monitor de Portas & Serviços</h1>
    <p>Visualize as portas TCP ativas no sistema para planejar e alocar portas livres para seus projetos.</p>
  </div>
  <% if (currentUser && currentUser.role === 'ADMIN') { %>
    <a href="/projects/create" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Novo Projeto (Porta Sugerida: :<%= suggestedPort %>)
    </a>
  <% } %>
</div>

<!-- Cards de Resumo & Sugestão -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
  <div class="stat-card" style="border-color: rgba(0, 240, 255, 0.3);">
    <div class="stat-icon-box stat-cyan">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value" style="color: var(--accent-cyan);">:<%= suggestedPort %></div>
      <div class="stat-label">Próxima Porta Livre Recomendada</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon-box stat-amber">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
    </div>
    <div class="stat-info">
      <div class="stat-value"><%= occupiedPorts.length %></div>
      <div class="stat-label">Total de Portas TCP Ocupadas</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
      Portas Ocupadas no Sistema Operacional
    </div>
    <div style="width: 260px;">
      <input type="text" id="portSearchInput" class="form-control form-control-mono" placeholder="🔍 Filtrar por porta ou serviço..." style="padding: 6px 12px; font-size: 0.8rem;">
    </div>
  </div>
  <div class="card-body" style="padding: 0;">
    <div class="table-container">
      <table class="data-table" id="portsTable">
        <thead>
          <tr>
            <th>Porta TCP</th>
            <th>Serviço / Aplicação</th>
            <th>Origem</th>
            <th>PID</th>
            <th>Endereço Local</th>
            <th style="text-align: right;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% occupiedPorts.forEach(function(item) { %>
            <tr class="port-row">
              <td>
                <span style="font-family: var(--font-mono); font-weight: 700; font-size: 1.05rem; color: var(--accent-cyan);">
                  :<%= item.port %>
                </span>
              </td>
              <td>
                <strong style="color: var(--text-main);"><%= item.description %></strong>
              </td>
              <td>
                <% if (item.project) { %>
                  <span class="status-pill status-<%= item.project.status %>">
                    <span class="status-dot"></span>
                    <span class="status-text">Sentinela: <%= item.project.status %></span>
                  </span>
                <% } else { %>
                  <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; background: rgba(255, 255, 255, 0.05); color: var(--text-muted); padding: 3px 8px; border-radius: 4px; border: 1px solid var(--border-subtle);">
                    Sistema / Externo
                  </span>
                <% } %>
              </td>
              <td style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted);">
                <%= item.pid ? '#' + item.pid : '-' %>
              </td>
              <td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-dim);">
                http://<%= primaryIp %>:<%= item.port %>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px;">
                  <% if (item.project) { %>
                    <a href="/projects/<%= item.project.id %>/terminal" class="btn btn-secondary btn-sm">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                      Terminal
                    </a>
                  <% } %>
                  <a href="http://<%= primaryIp %>:<%= item.port %>" target="_blank" class="btn btn-secondary btn-sm" title="Abrir no Navegador">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Filtro de busca em tempo real na tabela de portas
  document.getElementById('portSearchInput').addEventListener('input', function(e) {
    const query = e.target.value.toLowerCase().trim();
    const rows = document.querySelectorAll('.port-row');
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      row.style.display = text.includes(query) ? '' : 'none';
    });
  });
</script>
