<div class="page-header">
  <div class="page-title-group">
    <h1>Editar Projeto: <%= project.name %></h1>
    <p>Ajuste comandos, variáveis de ambiente ou branch do repositório.</p>
  </div>
  <a href="/projects/<%= project.id %>/terminal" class="btn btn-secondary">Voltar ao Terminal</a>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
      Configurações Gerais
    </div>
  </div>
  <div class="card-body">
    <form action="/projects/<%= project.id %>/edit" method="POST">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="name">Nome do Projeto <span class="required">*</span></label>
          <input type="text" id="name" name="name" class="form-control" value="<%= project.name %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="branch">Branch Git</label>
          <input type="text" id="branch" name="branch" class="form-control form-control-mono" value="<%= project.branch %>">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="repoUrl">URL do Repositório GitHub <span class="required">*</span></label>
        <input type="url" id="repoUrl" name="repoUrl" class="form-control form-control-mono" value="<%= project.repoUrl %>" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="gitToken">Token de Acesso Pessoal / GitHub Token (Opcional)</label>
        <input type="password" id="gitToken" name="gitToken" class="form-control form-control-mono" value="<%= project.gitToken || '' %>" placeholder="Deixe em branco para manter inalterado">
      </div>

      <!-- Seletor de Stack / Tecnologia -->
      <div class="form-group">
        <label class="form-label">Stack Tecnológica & Ambiente de Execução</label>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 8px;">
          <label class="stack-option <%= (!project.projectType || project.projectType === 'NODEJS') ? 'active' : '' %>" id="optStackNode" style="cursor: pointer;">
            <input type="radio" name="projectType" value="NODEJS" <%= (!project.projectType || project.projectType === 'NODEJS') ? 'checked' : '' %> style="display: none;">
            <div style="font-size: 1.25rem; margin-bottom: 4px;">🟢</div>
            <div style="font-weight: 700; font-size: 0.9rem; color: var(--text-main);">Node.js</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">npm, yarn ou pnpm</div>
          </label>

          <label class="stack-option <%= project.projectType === 'PYTHON' ? 'active' : '' %>" id="optStackPython" style="cursor: pointer;">
            <input type="radio" name="projectType" value="PYTHON" <%= project.projectType === 'PYTHON' ? 'checked' : '' %> style="display: none;">
            <div style="font-size: 1.25rem; margin-bottom: 4px;">🐍</div>
            <div style="font-weight: 700; font-size: 0.9rem; color: var(--text-main);">Python (venv Isolado)</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Cria e isola venv sem concorrência</div>
          </label>

          <label class="stack-option <%= project.projectType === 'GENERIC' ? 'active' : '' %>" id="optStackGeneric" style="cursor: pointer;">
            <input type="radio" name="projectType" value="GENERIC" <%= project.projectType === 'GENERIC' ? 'checked' : '' %> style="display: none;">
            <div style="font-size: 1.25rem; margin-bottom: 4px;">⚙️</div>
            <div style="font-weight: 700; font-size: 0.9rem; color: var(--text-main);">Customizado / Outro</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Comandos manuais livres</div>
          </label>
        </div>
        <div id="pythonVenvNotice" style="<%= project.projectType === 'PYTHON' ? '' : 'display: none;' %> background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: var(--radius-md); padding: 10px 14px; font-size: 0.8rem; color: #93c5fd; margin-top: 8px;">
          💡 <strong>Isolamento Automático:</strong> O Sentinela criará o ambiente virtual <code>venv</code> local automaticamente antes do deploy e injetará o interpretador isolado na execução do projeto, impedindo qualquer conflito de dependências.
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="installCommand">Comando de Instalação</label>
          <input type="text" id="installCommand" name="installCommand" class="form-control form-control-mono" value="<%= project.installCommand %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="buildCommand">Comando de Build (Opcional)</label>
          <input type="text" id="buildCommand" name="buildCommand" class="form-control form-control-mono" value="<%= project.buildCommand || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="startCommand">Comando de Inicialização</label>
          <input type="text" id="startCommand" name="startCommand" class="form-control form-control-mono" value="<%= project.startCommand %>" required>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group" style="flex: 1;">
          <label class="form-label" for="port">Porta de Serviço do Projeto</label>
          <div style="display: flex; gap: 10px;">
            <input type="number" id="port" name="port" class="form-control form-control-mono" value="<%= project.port || '' %>" placeholder="ex: 3001">
            <button type="button" id="btnSuggestPort" class="btn btn-secondary" style="white-space: nowrap; font-size: 0.8rem;" title="Descobrir e preencher com a próxima porta livre">
              ⚡ Sugerir Porta Livre
            </button>
          </div>
          <div id="portValidationMsg" style="font-size: 0.8rem; margin-top: 6px; display: none;"></div>
          <div class="form-hint">Porta em que o serviço responderá na rede local (LAN).</div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="envVars">Variáveis de Ambiente</label>
        <textarea id="envVars" name="envVars" class="form-control form-control-mono" rows="4"><%= project.envVars || '' %></textarea>
      </div>

      <div class="form-group" style="margin-top: 24px; display: flex; flex-direction: column; gap: 14px;">
        <label class="form-check">
          <input type="checkbox" name="autoRestart" id="autoRestart" <%= project.autoRestart ? 'checked' : '' %>>
          <span><strong>Auto-Restart:</strong> Reiniciar automaticamente se o processo encerrar inesperadamente.</span>
        </label>

        <label class="form-check">
          <input type="checkbox" name="ignoreSsl" id="ignoreSsl" <%= project.ignoreSsl ? 'checked' : '' %>>
          <span><strong>Ignorar Verificação de Certificados SSL:</strong> Desativa checagem estrita de SSL em <code>pip</code>, <code>npm</code>, <code>git</code> e <code>node</code> (essencial para redes corporativas com proxy, firewall ou certificados autoassinados).</span>
        </label>

        <div style="background: rgba(0, 240, 255, 0.04); border: 1px solid rgba(0, 240, 255, 0.2); border-radius: var(--radius-md); padding: 16px;">
          <label class="form-check">
            <input type="checkbox" name="autoSync" id="autoSync" <%= project.autoSync ? 'checked' : '' %>>
            <span style="font-weight: 700; color: var(--accent-cyan);">⚡ Ativar Auto-Sync do GitHub (Deploy Automático em Segundo Plano)</span>
          </label>
          <div class="form-hint" style="margin-top: 6px;">
            O servidor consultará periodicamente o GitHub. Ao detectar um novo <code>git push</code>, fará o Re-Deploy automaticamente sem precisar de IP público ou Webhooks externos!
          </div>
          <div style="margin-top: 10px; display: flex; align-items: center; gap: 10px;">
            <label class="form-label" for="syncIntervalMinutes" style="margin-bottom: 0; font-size: 0.85rem;">Intervalo de Verificação:</label>
            <select name="syncIntervalMinutes" id="syncIntervalMinutes" class="form-control form-control-mono" style="width: 170px; padding: 6px 10px; font-size: 0.85rem;">
              <option value="1" <%= project.syncIntervalMinutes === 1 ? 'selected' : '' %>>A cada 1 minuto</option>
              <option value="2" <%= (!project.syncIntervalMinutes || project.syncIntervalMinutes === 2) ? 'selected' : '' %>>A cada 2 minutos</option>
              <option value="5" <%= project.syncIntervalMinutes === 5 ? 'selected' : '' %>>A cada 5 minutos</option>
              <option value="10" <%= project.syncIntervalMinutes === 10 ? 'selected' : '' %>>A cada 10 minutos</option>
            </select>
          </div>
        </div>
      </div>

      <div style="margin-top: 32px; display: flex; justify-content: flex-end; gap: 12px;">
        <a href="/projects/<%= project.id %>/terminal" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      </div>
    </form>
  </div>
</div>

<script>
  // Manipulação de Stack / Preset
  const stackOptions = document.querySelectorAll('.stack-option');
  const installCommandInput = document.getElementById('installCommand');
  const startCommandInput = document.getElementById('startCommand');
  const pythonVenvNotice = document.getElementById('pythonVenvNotice');

  stackOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      stackOptions.forEach(o => o.classList.remove('active'));
      opt.classList.add('active');
      const radio = opt.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;

      const val = radio.value;
      if (val === 'PYTHON') {
        if (!installCommandInput.value || installCommandInput.value === 'npm install') {
          installCommandInput.value = 'pip install -r requirements.txt';
        }
        if (!startCommandInput.value || startCommandInput.value === 'npm start') {
          startCommandInput.value = 'python app.py';
        }
        pythonVenvNotice.style.display = 'block';
      } else if (val === 'NODEJS') {
        if (!installCommandInput.value || installCommandInput.value === 'pip install -r requirements.txt') {
          installCommandInput.value = 'npm install';
        }
        if (!startCommandInput.value || startCommandInput.value === 'python app.py') {
          startCommandInput.value = 'npm start';
        }
        pythonVenvNotice.style.display = 'none';
      } else {
        pythonVenvNotice.style.display = 'none';
      }
    });
  });

  const portInput = document.getElementById('port');
  const btnSuggestPort = document.getElementById('btnSuggestPort');
  const portValidationMsg = document.getElementById('portValidationMsg');

  // Sugere próxima porta livre
  btnSuggestPort.addEventListener('click', async () => {
    btnSuggestPort.disabled = true;
    btnSuggestPort.innerText = 'Buscando...';
    try {
      const res = await fetch('/api/ports/suggest');
      const data = await res.json();
      if (data.success && data.suggestedPort) {
        portInput.value = data.suggestedPort;
        validatePort(data.suggestedPort);
      }
    } catch (e) {
      console.error(e);
    } finally {
      btnSuggestPort.disabled = false;
      btnSuggestPort.innerText = '⚡ Sugerir Porta Livre';
    }
  });

  // Validação em tempo real
  let debounceTimeout = null;
  portInput.addEventListener('input', () => {
    clearTimeout(debounceTimeout);
    debounceTimeout = setTimeout(() => {
      const portVal = portInput.value.trim();
      if (portVal) {
        validatePort(portVal);
      } else {
        portValidationMsg.style.display = 'none';
      }
    }, 400);
  });

  async function validatePort(port) {
    try {
      const res = await fetch(`/api/ports/check/${port}`);
      const data = await res.json();
      portValidationMsg.style.display = 'block';

      if (data.available) {
        portValidationMsg.style.color = '#34d399';
        portValidationMsg.innerHTML = `✓ Porta <strong>:${port}</strong> está disponível e livre para uso.`;
      } else {
        portValidationMsg.style.color = '#f87171';
        portValidationMsg.innerHTML = `⚠️ Porta <strong>:${port}</strong> está ocupada por: ${data.usedBy || 'Outro serviço'}`;
      }
    } catch (e) {
      console.error(e);
    }
  }
</script>
