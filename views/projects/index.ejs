<div class="page-header">
  <div class="page-title-group">
    <h1>Projetos & Aplicações</h1>
    <p>Lista de todas as aplicações e Workspaces ativas no servidor Sentinela.</p>
  </div>
  <% if (currentUser && currentUser.role === 'ADMIN') { %>
    <div style="display: flex; gap: 10px;">
      <a href="/workspaces/create" class="btn btn-secondary">
        + Novo Workspace
      </a>
      <a href="/projects/create" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Puxar Novo Projeto
      </a>
    </div>
  <% } %>
</div>

<!-- Se houver Workspaces cadastrados, exibe em destaque -->
<% if (typeof workspaces !== 'undefined' && workspaces && workspaces.length > 0) { %>
  <div style="margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
        Workspaces (<%= workspaces.length %>)
      </h2>
      <a href="/workspaces" class="btn btn-secondary btn-sm">Ver Todos no Painel Workspaces →</a>
    </div>

    <div class="projects-grid">
      <% workspaces.forEach(function(ws) { %>
        <div class="project-card" style="border-top: 4px solid var(--accent-cyan);">
          <div>
            <div class="project-top">
              <div>
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                  <div class="project-name" style="font-size: 1.1rem;"><%= ws.name %></div>
                  <span class="badge-autosync" style="background: rgba(0, 200, 255, 0.1); color: var(--accent-cyan); border-color: rgba(0, 200, 255, 0.2);">
                    📁 Workspace (<%= ws.projects ? ws.projects.length : 0 %> <%= (ws.projects && ws.projects.length === 1) ? 'Projeto' : 'Projetos' %>)
                  </span>
                  <% if (ws.autoSync) { %>
                    <span class="badge-autosync" title="Sincronização automática via GitHub">⚡ Auto-Sync</span>
                  <% } %>
                </div>
                <div class="project-repo">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                  <%= ws.repoUrl %>
                </div>
              </div>
            </div>

            <div style="margin-top: 12px; background: var(--bg-surface-elevated); padding: 8px 12px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
              <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); margin-bottom: 4px; font-weight: 600;">Portas do Workspace:</div>
              <% if (ws.projects && ws.projects.length > 0) { %>
                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                  <% ws.projects.forEach(function(p) { %>
                    <span class="status-pill status-<%= p.status %>" style="font-size: 0.7rem; padding: 2px 6px;">
                      <span class="status-dot"></span>
                      <%= p.name %> <%= p.port ? '(:' + p.port + ')' : '' %>
                    </span>
                  <% }); %>
                </div>
              <% } else { %>
                <span style="font-size: 0.75rem; color: var(--text-muted);">Nenhum projeto adicionado</span>
              <% } %>
            </div>
          </div>

          <div class="project-actions" style="margin-top: 16px;">
            <a href="/workspaces/<%= ws.id %>" class="btn btn-primary btn-sm" style="flex: 1;">
              Abrir Workspace
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<!-- Todos os Projetos -->
<h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
  Projetos e Serviços
</h2>

<% if (projects.length === 0) { %>
  <div class="card">
    <div class="card-body" style="text-align: center; padding: 60px 24px;">
      <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; opacity: 0.4;"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
      <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 8px;">Nenhum projeto cadastrado</h3>
      <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 480px; margin: 0 auto 20px;">
        Importe repositórios do GitHub ou crie Workspaces para executar suas aplicações.
      </p>
      <% if (currentUser && currentUser.role === 'ADMIN') { %>
        <a href="/projects/create" class="btn btn-primary">Puxar do GitHub</a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="projects-grid">
    <% projects.forEach(function(project) { %>
      <div class="project-card">
        <div>
          <div class="project-top">
            <div>
              <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <div class="project-name"><%= project.name %></div>
                <%- include('../partials/tech-badge', { project: project }) %>
                <% if (project.workspace) { %>
                  <a href="/workspaces/<%= project.workspace.id %>" class="badge-autosync" style="background: rgba(0, 200, 255, 0.1); color: var(--accent-cyan); border-color: rgba(0, 200, 255, 0.2); text-decoration: none;" title="Este projeto pertence ao Workspace <%= project.workspace.name %>">
                    📁 Workspace: <%= project.workspace.name %>
                  </a>
                <% } %>
                <% if (project.autoSync) { %>
                  <span class="badge-autosync" title="Sincronização automática a cada <%= project.syncIntervalMinutes || 2 %> minutos">⚡ Auto-Sync</span>
                <% } %>
                <% if (project.hasReadme) { %>
                  <a href="/projects/<%= project.id %>/readme" class="badge-readme-count" style="text-decoration: none;" title="Clique para abrir o leitor de documentação">
                    📖 <%= project.readmeCount %> <%= project.readmeCount === 1 ? 'Documento' : 'Documentos' %>
                  </a>
                <% } %>
              </div>
              <div class="project-repo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                <%= project.repoUrl %>
              </div>
            </div>
            <span class="status-pill status-<%= project.status %>" data-project-status-id="<%= project.id %>">
              <span class="status-dot"></span>
              <span class="status-text"><%= project.status %></span>
            </span>
          </div>

          <div class="project-meta-list">
            <div class="project-meta-item">
              <span class="meta-label">Branch</span>
              <span class="meta-value"><%= project.branch %></span>
            </div>
            <div class="project-meta-item">
              <span class="meta-label">Processo PID</span>
              <span class="meta-value" data-project-pid-id="<%= project.id %>">
                <%= project.pid ? '#' + project.pid : 'Inativo' %>
              </span>
            </div>
            <div class="project-meta-item">
              <span class="meta-label">Porta de Serviço</span>
              <span class="meta-value">
                <%= project.port ? ':' + project.port : 'Padrão' %>
              </span>
            </div>
            <div class="project-meta-item">
              <span class="meta-label">Último Deploy</span>
              <span class="meta-value" style="font-size: 0.75rem;">
                <%= project.lastDeployedAt ? new Date(project.lastDeployedAt).toLocaleString('pt-BR') : 'Pendente' %>
              </span>
            </div>
          </div>
        </div>

        <div class="project-actions">
          <a href="/projects/<%= project.id %>/terminal" class="btn btn-primary btn-sm" style="flex: 1;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
            Terminal / Logs
          </a>

          <a href="/projects/<%= project.id %>/readme" class="btn btn-secondary btn-sm" title="Ver Documentação e READMEs">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            README
          </a>

          <% if (currentUser && currentUser.role === 'ADMIN') { %>
            <a href="/projects/<%= project.id %>/edit" class="btn btn-secondary btn-sm" title="Editar Configurações">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            </a>

            <form action="/projects/<%= project.id %>/delete" method="POST" class="confirm-delete-form" data-confirm-text="Tem certeza que deseja excluir o projeto '<%= project.name %>'?" style="display: inline;">
              <button type="submit" class="btn btn-danger btn-sm" title="Excluir Projeto">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
            </form>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>
