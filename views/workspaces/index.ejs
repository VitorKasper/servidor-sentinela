<div class="page-header">
  <div class="page-title-group">
    <h1>Workspaces</h1>
    <p>Agrupamento de projetos compartilhando o mesmo repositório clonado no servidor.</p>
  </div>
  <% if (currentUser && currentUser.role === 'ADMIN') { %>
    <div>
      <a href="/workspaces/create" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Criar Novo Workspace
      </a>
    </div>
  <% } %>
</div>

<% if (workspaces.length === 0) { %>
  <div class="card">
    <div class="card-body" style="text-align: center; padding: 60px 24px;">
      <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; opacity: 0.4;"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
      <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 8px;">Nenhum Workspace cadastrado</h3>
      <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 520px; margin: 0 auto 20px;">
        Workspaces permitem clonar um repositório GitHub uma única vez e executar múltiplos projetos/portas a partir da mesma pasta compartilhada.
      </p>
      <% if (currentUser && currentUser.role === 'ADMIN') { %>
        <a href="/workspaces/create" class="btn btn-primary">Criar Workspace</a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="projects-grid">
    <% workspaces.forEach(function(ws) { %>
      <div class="project-card" style="border-top: 4px solid var(--accent-cyan);">
        <div>
          <div class="project-top">
            <div>
              <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <div class="project-name" style="font-size: 1.15rem;"><%= ws.name %></div>
                <span class="badge-autosync" style="background: rgba(0, 200, 255, 0.1); color: var(--accent-cyan); border-color: rgba(0, 200, 255, 0.2);">
                  📁 <%= ws.projects ? ws.projects.length : 0 %> <%= (ws.projects && ws.projects.length === 1) ? 'Projeto' : 'Projetos' %>
                </span>
                <% if (ws.autoSync) { %>
                  <span class="badge-autosync" title="Auto-Sync ativado">⚡ Auto-Sync</span>
                <% } %>
              </div>
              <div class="project-repo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                <%= ws.repoUrl %>
              </div>
            </div>
          </div>

          <div style="margin-top: 14px; background: var(--bg-surface-elevated); padding: 10px 14px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
            <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); margin-bottom: 6px; font-weight: 600;">Portas & Serviços Configurados:</div>
            <% if (ws.projects && ws.projects.length > 0) { %>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <% ws.projects.forEach(function(p) { %>
                  <span class="status-pill status-<%= p.status %>" style="font-size: 0.75rem; padding: 3px 8px;">
                    <span class="status-dot"></span>
                    <%= p.name %> <%= p.port ? '(:' + p.port + ')' : '' %>
                  </span>
                <% }); %>
              </div>
            <% } else { %>
              <span style="font-size: 0.8rem; color: var(--text-muted);">Nenhum projeto adicionado ainda</span>
            <% } %>
          </div>
        </div>

        <div class="project-actions" style="margin-top: 20px;">
          <a href="/workspaces/<%= ws.id %>" class="btn btn-primary btn-sm" style="flex: 1;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"></path><path d="M10 14L21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
            Abrir Workspace
          </a>

          <% if (currentUser && currentUser.role === 'ADMIN') { %>
            <form action="/workspaces/<%= ws.id %>/start-all" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-secondary btn-sm" title="Iniciar Todos os Projetos">
                ▶ Iniciar Todos
              </button>
            </form>
            <form action="/workspaces/<%= ws.id %>/stop-all" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-secondary btn-sm" title="Parar Todos os Projetos">
                ⏹ Parar Todos
              </button>
            </form>
            <form action="/workspaces/<%= ws.id %>/delete" method="POST" class="confirm-delete-form" data-confirm-text="Tem certeza que deseja excluir o Workspace '<%= ws.name %>'? A pasta clonada e todos os projetos vinculados serão apagados." style="display: inline;">
              <button type="submit" class="btn btn-danger btn-sm" title="Excluir Workspace">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
            </form>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>
