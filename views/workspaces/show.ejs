<div class="page-header">
  <div class="page-title-group">
    <div style="display: flex; align-items: center; gap: 10px;">
      <a href="/workspaces" class="btn btn-secondary btn-sm" title="Voltar para a Lista de Workspaces">
        ← Voltar
      </a>
      <h1 style="margin: 0;"><%= workspace.name %></h1>
    </div>
    <p style="margin-top: 4px; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
      <%= workspace.repoUrl %> (branch: <%= workspace.branch %>) &bull; Um clone, um setup, <%= projects.length %> terminal(is) &bull;
      Pipeline: <%= workspace.pipelineSource === 'REPO' ? 'definido no repositorio' : 'definido na interface' %>
    </p>
  </div>
  
  <% if (currentUser && currentUser.role === 'ADMIN') { %>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <form action="/workspaces/<%= workspace.id %>/start-all" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-secondary">▶ Iniciar Todos</button>
      </form>
      <form action="/workspaces/<%= workspace.id %>/stop-all" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-secondary">⏹ Parar Todos</button>
      </form>
      <form action="/workspaces/<%= workspace.id %>/deploy-all" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-secondary">⚡ Re-Deploy Workspace</button>
      </form>
      <a href="/workspaces/<%= workspace.id %>/pipeline" class="btn btn-secondary" title="Ver e editar o pipeline deste Workspace">
        &#9881; Pipeline
      </a>
      <button type="button" class="btn btn-primary" onclick="document.getElementById('addProjectModal').style.display='flex'">
        + Adicionar Projeto
      </button>
    </div>
  <% } %>
</div>

<!-- Banner de Loading / Instalação em Segundo Plano -->
<% const hasBuildingProject = projects.some(p => p.status === 'BUILDING'); %>
<div id="workspaceLoadingBanner" class="card" style="background: rgba(255, 189, 46, 0.08); border: 1px solid rgba(255, 189, 46, 0.3); margin-bottom: 24px; display: <%= hasBuildingProject ? 'block' : 'none' %>;">
  <div class="card-body" style="display: flex; align-items: center; gap: 16px; padding: 16px 20px;">
    <div class="deploy-spinner"></div>
    <div>
      <strong style="color: #ffbd2e; font-size: 1rem;">⚡ Instalando Dependências em Segundo Plano...</strong>
      <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
        O repositório do Workspace está clonando, baixando dependências (npm/pip) e preparando o ambiente. Os serviços serão iniciados automaticamente assim que a instalação for concluída.
      </div>
    </div>
  </div>
</div>

<!-- Projetos do Workspace -->
<% if (projects.length === 0) { %>
  <div class="card">
    <div class="card-body" style="text-align: center; padding: 60px 24px;">
      <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; opacity: 0.4;"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
      <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 8px;">Nenhum projeto neste Workspace</h3>
      <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 480px; margin: 0 auto 20px;">
        Adicione portas/serviços (ex: API na 3000, Frontend na 5000, Worker na 8000) que serão executados a partir deste repositório clonado.
      </p>
      <% if (currentUser && currentUser.role === 'ADMIN') { %>
        <button type="button" class="btn btn-primary" onclick="document.getElementById('addProjectModal').style.display='flex'">
          + Adicionar Primeiro Projeto
        </button>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="projects-grid">
    <% projects.forEach(function(project) { %>
      <div class="project-card">
        <div>
          <div class="project-top">
            <div>
              <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <div class="project-name"><%= project.name %></div>
                <%- include('../partials/tech-badge', { project: project }) %>
                <% if (project.autoSync) { %>
                  <span class="badge-autosync" title="Sincronização automática a cada <%= project.syncIntervalMinutes || 2 %> minutos">⚡ Auto-Sync</span>
                <% } %>
                <% if (project.hasReadme) { %>
                  <a href="/projects/<%= project.id %>/readme" class="badge-readme-count" style="text-decoration: none;" title="Clique para abrir o leitor de documentação">
                    📖 <%= project.readmeCount %> <%= project.readmeCount === 1 ? 'Documento' : 'Documentos' %>
                  </a>
                <% } %>
              </div>
              <div class="project-repo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                Cmd: <code style="color: var(--accent-cyan); font-family: var(--font-mono);"><%= project.startCommand %></code>
              </div>
            </div>
            <span class="status-pill status-<%= project.status %>" data-project-status-id="<%= project.id %>">
              <span class="status-dot"></span>
              <span class="status-text"><%= project.status %></span>
            </span>
          </div>

          <div class="project-meta-list">
            <div class="project-meta-item">
              <span class="meta-label">Branch</span>
              <span class="meta-value"><%= project.branch %></span>
            </div>
            <div class="project-meta-item">
              <span class="meta-label">Processo PID</span>
              <span class="meta-value" data-project-pid-id="<%= project.id %>">
                <%= project.pid ? '#' + project.pid : 'Inativo' %>
              </span>
            </div>
            <div class="project-meta-item">
              <span class="meta-label">Porta de Serviço</span>
              <span class="meta-value">
                <% if (project.port) { %>
                  <a href="http://<%= primaryIp %>:<%= project.port %>" target="_blank" style="color: var(--accent-cyan); text-decoration: underline;">
                    :<%= project.port %>
                  </a>
                <% } else { %>
                  Padrão
                <% } %>
              </span>
            </div>
            <div class="project-meta-item">
              <span class="meta-label">Último Deploy</span>
              <span class="meta-value" style="font-size: 0.75rem;">
                <%= project.lastDeployedAt ? new Date(project.lastDeployedAt).toLocaleString('pt-BR') : 'Pendente' %>
              </span>
            </div>
          </div>
        </div>

        <div class="project-actions">
          <a href="/projects/<%= project.id %>/terminal" class="btn btn-primary btn-sm" style="flex: 1;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
            Terminal / Logs
          </a>

          <a href="/projects/<%= project.id %>/readme" class="btn btn-secondary btn-sm" title="Ver Documentação e READMEs">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            README
          </a>

          <% if (currentUser && currentUser.role === 'ADMIN') { %>
            <a href="/projects/<%= project.id %>/edit" class="btn btn-secondary btn-sm" title="Editar Configurações">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            </a>

            <form action="/projects/<%= project.id %>/delete" method="POST" class="confirm-delete-form" data-confirm-text="Tem certeza que deseja excluir o projeto '<%= project.name %>'?" style="display: inline;">
              <button type="submit" class="btn btn-danger btn-sm" title="Excluir Projeto">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
            </form>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<!-- Modal Adicionar Projeto ao Workspace -->
<div id="addProjectModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; padding: 20px;">
  <div class="card" style="width: 100%; max-width: 550px; background: var(--bg-surface);">
    <div class="card-header">
      <div class="card-title">+ Adicionar Projeto ao Workspace</div>
      <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('addProjectModal').style.display='none'">✕</button>
    </div>
    <div class="card-body">
      <form action="/workspaces/<%= workspace.id %>/add-project" method="POST">
        <div class="form-group">
          <label class="form-label">Nome do Projeto / Serviço *</label>
          <input type="text" name="name" class="form-control" placeholder="ex: Backend API, Web App, Worker" required>
        </div>

        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <label class="form-label" style="margin: 0;">Porta de Serviço (LAN)</label>
            <button type="button" class="btn btn-secondary btn-sm" style="padding: 2px 8px; font-size: 0.75rem;" onclick="suggestPortModal(this)">✨ Sugerir Porta Livre</button>
          </div>
          <input type="number" name="port" id="modalPortInput" class="form-control" placeholder="ex: 3001, 5000, 8000">
        </div>

        <div class="form-group">
          <label class="form-label">Comando de Inicialização *</label>
          <input type="text" name="startCommand" class="form-control" placeholder="ex: npm run start:api, node server.js" required>
        </div>

        <div class="form-group">
          <label class="form-label">Tecnologia / Stack</label>
          <select name="projectType" class="form-control">
            <option value="NODEJS">Node.js</option>
            <option value="PYTHON">Python</option>
            <option value="GENERIC">Genérico</option>
          </select>
        </div>

        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <label class="form-label" style="margin: 0;">Variáveis de Ambiente Específicas (.env)</label>
            <label class="btn btn-secondary btn-sm" style="margin: 0; cursor: pointer; padding: 2px 8px; font-size: 0.75rem;">
              📥 Importar .env
              <input type="file" accept=".env,.env.*,.txt" onchange="handleModalEnvUpload(event)" style="display: none;">
            </label>
          </div>
          <textarea name="envVars" id="modalEnvVars" class="form-control" rows="4" placeholder="KEY=VALUE" style="font-family: var(--font-mono); font-size: 0.85rem;"></textarea>
        </div>

        <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px;">
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('addProjectModal').style.display='none'">Cancelar</button>
          <button type="submit" class="btn btn-primary">Adicionar Projeto</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  async function suggestPortModal(btn) {
    btn.innerText = '⏳ Checando...';
    try {
      const res = await fetch('/api/ports/suggest');
      const data = await res.json();
      if (data.success && data.suggestedPort) {
        document.getElementById('modalPortInput').value = data.suggestedPort;
        btn.innerText = '✓ ' + data.suggestedPort;
      } else {
        btn.innerText = '✨ Sugerir Porta Livre';
      }
    } catch(e) {
      btn.innerText = '✨ Sugerir Porta Livre';
    }
  }

  function handleModalEnvUpload(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
      const textarea = document.getElementById('modalEnvVars');
      if (textarea) textarea.value = e.target.result.trim();
    };
    reader.readAsText(file);
  }
</script>

<script src="/socket.io/socket.io.js"></script>
<script>
  (function() {
    if (typeof io === 'undefined') return;
    const socket = io();

    socket.on('project_status', function(data) {
      const { projectId, status, pid } = data;

      // Atualiza Pílula de Status
      const statusPills = document.querySelectorAll(`[data-project-status-id="${projectId}"]`);
      statusPills.forEach(pill => {
        pill.className = `status-pill status-${status}`;
        const textSpan = pill.querySelector('.status-text');
        if (textSpan) textSpan.innerText = status;
      });

      // Atualiza PID
      const pidElements = document.querySelectorAll(`[data-project-pid-id="${projectId}"]`);
      pidElements.forEach(el => {
        el.innerText = pid ? '#' + pid : 'Inativo';
      });

      // Oculta/Exibe o Banner de Instalação/Loading
      const anyBuilding = Array.from(document.querySelectorAll('.status-pill')).some(p => p.classList.contains('status-BUILDING'));
      const banner = document.getElementById('workspaceLoadingBanner');
      if (banner) {
        banner.style.display = anyBuilding ? 'block' : 'none';
      }
    });
  })();
</script>
